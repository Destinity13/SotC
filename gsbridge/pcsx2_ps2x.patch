+// ps2x (SotC Recomp): Live-Modus. Statt aus einer .gs-Datei kommen die Pakete aus einem nativen Port
+// (Transfer/VSync/Register im selben Format wie ein GS-Dump), siehe ps2x-gsbridge.
+#include <condition_variable>
+#include <deque>
+#include <mutex>
+namespace
+{
+	struct LivePacket
+	{
+		u8 type; // 0 Transfer, 1 VSync, 3 Register
+		u8 path; // Transfer: GIF_PATH (0..2), VSync: Halbbild
+		std::vector<u8> data;
+	};
+	std::mutex s_live_mutex;
+	std::condition_variable s_live_cv;
+	std::deque<LivePacket> s_live_queue;
+	bool s_live = false;
+	std::vector<std::vector<u8>> s_live_free; // wiederverwendete Paketpuffer (keine malloc pro Paket)
+	bool s_live_waiting = false; // Verbraucher schlaeft -> nur dann wecken (spart futex pro Paket)
+	constexpr const char* LIVE_SUFFIX = "ps2x_live.gs";
+} // namespace
+
+// Erzeuger (Port): Grafikpakete je Thread gesammelt und gebuendelt uebergeben (eine Sperre je 64 Pakete statt je
+// Paket - die Sperre war im Profil der groesste Bremsklotz im VU1-Thread). VSync/Register leeren vorher den Puffer.
+namespace
+{
+	struct LiveBatch
+	{
+		std::vector<LivePacket> pkts;
+		std::vector<std::vector<u8>> free; // eigene wiederverwendbare Puffer dieses Threads
+	};
+	thread_local LiveBatch t_batch;
+
+	void LiveFlushLocked(LiveBatch& b)
+	{
+		for (auto& p : b.pkts)
+			s_live_queue.push_back(std::move(p));
+		b.pkts.clear();
+		// wiederverwendbare Puffer aus dem gemeinsamen Pool holen
+		while (b.free.size() < 64 && !s_live_free.empty())
+		{
+			b.free.push_back(std::move(s_live_free.back()));
+			s_live_free.pop_back();
+		}
+	}
+}
+
+void GSDumpReplayer::LiveFlush()
+{
+	LiveBatch& b = t_batch;
+	if (b.pkts.empty())
+		return;
+	bool wake;
+	{
+		std::lock_guard<std::mutex> lk(s_live_mutex);
+		LiveFlushLocked(b);
+		wake = s_live_waiting;
+	}
+	if (wake)
+		s_live_cv.notify_one();
+}
+
+void GSDumpReplayer::LivePush(u8 type, u8 path, const u8* data, u32 size)
+{
+	LiveBatch& b = t_batch;
+	LivePacket p{type, path, {}};
+	if (!b.free.empty())
+	{
+		p.data = std::move(b.free.back());
+		b.free.pop_back();
+	}
+	if (data && size)
+		p.data.assign(data, data + size);
+	else
+		p.data.clear();
+	b.pkts.push_back(std::move(p));
+	if (type != 0 || b.pkts.size() >= 64u)
+		LiveFlush();
+}
+
+bool GSDumpReplayer::IsLiveMode()
+{
+	return s_live;
+}
+
+size_t GSDumpReplayer::LiveQueueSize()
+{
+	std::lock_guard<std::mutex> lk(s_live_mutex);
+	return s_live_queue.size();
+}
