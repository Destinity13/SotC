+    std::string InstructionTranslator::translateDynamicImmediate(const Instruction &inst)
+    {
+        // Translate with sentinel immediates, then swap them for live reads of the
+        // instruction word, so the game's own runtime relocation of this word is honoured.
+        static constexpr uint32_t kSentinelS = 0x5A5A5A5Au;
+        static constexpr uint32_t kSentinelU = 0x5A5A5A5Bu;
+        Instruction probe = inst;
+        probe.simmediate = kSentinelS;
+        probe.immediate = kSentinelU;
+        std::string code = translate(probe, MemoryAccessHint{}, /*allowDynamic=*/false);
+        const std::string word = fmt::format("READ32(0x{:X}u)", inst.address);
+        const std::string liveS = fmt::format("((uint32_t)(int32_t)(int16_t)({} & 0xFFFFu))", word);
+        const std::string liveU = fmt::format("((uint32_t)({} & 0xFFFFu))", word);
+        const std::string sentS = std::to_string(kSentinelS);
+        const std::string sentU = std::to_string(kSentinelU);
+        bool replaced = false;
+        for (const auto &[from, to] : {std::pair{sentU, liveU}, std::pair{sentS, liveS}})
+        {
+            for (size_t pos = code.find(from); pos != std::string::npos; pos = code.find(from, pos + to.size()))
+            {
+                code.replace(pos, from.size(), to);
+                replaced = true;
+            }
+        }
+        if (!replaced)
+        {
+            return code + fmt::format(" /* WARNING: dynamic immediate at 0x{:X} not applied for this opcode */", inst.address);
+        }
+        return code + " /* dynamic immediate */";
+    }
